  {
    "description" : "",
    "role" : "AXTextArea",
    "title" : "TypeScript 脚本",
    "value" : "interface Value { value: number }\ninterface Ready { ready: boolean }\ninterface Sent { sent: boolean }\ninterface Receipt { message: string; completedTaskIds: string[]; inProgressTaskIds: string[] }\nconst a = agent(\"原生验收甲\", { system: \"仅执行内部协作协议验收。禁止读写文件、运行命令、访问外网、创建代理或修改团队任务。允许 list_agents、team_task_list、send_message；每次 ask 必须使用 submit_result 返回要求的 JSON。\" });\nconst b = agent(\"原生验收乙\", { system: \"仅执行内部协作协议验收。禁止读写文件、运行命令、访问外网、创建代理或修改团队任务。每次 ask 必须使用 submit_result 返回要求的 JSON。\" });\nphase(\"并行固定结果\");\nconst initial = await Promise.all([\n  a.ask<Value>('Call submit_result with {\"value\":{\"value\":7}}. Do nothing else.'),\n  b.ask<Value>('Call submit_result with {\"value\":{\"value\":9}}. Do nothing else.')\n]);\nreport({ initial });\nphase(\"修订消息验收\");\nconst ready = await b.ask<Ready>('Call submit_result with {\"value\":{\"ready\":true}}. You are ready for the later engine-admitted receipt ask. Do nothing else.');\nconst nonce = \"TEAM_NONCE_00baefee-c52f-4802-8dd9-0191795f3a3a\";\nconst sent = await a.ask<Sent>('Call list_agents. Use send_message to teammate actor-2e37b7cfca7f66bf472164fc with message text equal to this JSON string: \"' + nonce + '\". Do not include quote characters. Only after a successful send, call submit_result with {\"value\":{\"sent\":true}}. Never create or update tasks.');\nconst receipt = await b.ask<Receipt>('From your received team messages, extract only the most recent token beginning TEAM_NONCE_ (without the Team message from envelope or punctuation); this prompt does not contain its value. If absent return message:\"\" rather than guessing. Call team_task_list and return the actual task IDs with status completed and in_progress in completedTaskIds and inProgressTaskIds. Use submit_result with value {message:the extracted token,completedTaskIds:[...],inProgressTaskIds:[...]}. Do not modify tasks.');\nif (!sent.sent || receipt.message !== nonce) throw new Error(\"Native message nonce did not match\");\nif (receipt.completedTaskIds.length < 2 || receipt.inProgressTaskIds.length !== 1) throw new Error(\"Native task projection was not authoritative\");\nreturn { initial, ready, matched: true, nonce, receipt };"
  },
