{
  "name": "dsh-composer-assist",
  "version": "0.7.5",
  "description": "DSH composer prediction plus opt-in ZCode Fusion agent workflows (development preview).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lphehe/dsh-composer-assist.git"
  },
  "bugs": {
    "url": "https://github.com/Lphehe/dsh-composer-assist/issues"
  },
  "homepage": "https://github.com/Lphehe/dsh-composer-assist#readme",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "node scripts/build-workflow.mjs && node scripts/build-client.mjs",
    "selfcheck": "pnpm run build && node selfcheck.mjs && node workflow/host/fusion-template-selfcheck.mjs && node workflow/client/fusion-ui-selfcheck.mjs && node workflow/client/selfcheck.mjs && node workflow/host/fusion-compile-selfcheck.mjs && node workflow/host/driver-selfcheck.mjs && node workflow/host/world-selfcheck.mjs && node workflow/host/selfcheck.mjs && node workflow/host/plugin-selfcheck.mjs && node scripts/bundle-freshness-selfcheck.mjs"
  },
  "dependencies": {
    "@zcode/dynamic-workflow": "file:vendor/zcode/dynamic-workflow",
    "@zcode/dynamic-workflow-runtime": "file:vendor/zcode/dynamic-workflow-runtime",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "vitest": "4.1.5",
    "esbuild": "^0.25.12"
  },
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./workflow": "./dist/workflow-host.js",
    "./workflow/locale/*.json": "./workflow/locale/*.json",
    "./workflow/icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots/*.png",
    "dist/compiler-worker.js",
    "dist/workflow-host.js",
    "workflow",
    "vendor/zcode",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "bundleDependencies": [
    "@zcode/dynamic-workflow",
    "@zcode/dynamic-workflow-runtime",
    "typescript"
  ],
  "private": true
}
