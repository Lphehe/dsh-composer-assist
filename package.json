{
  "name": "dsh-composer-assist",
  "version": "0.1.0",
  "type": "module",
  "description": "Context-aware composer predictions for DeepSeek Harness, with draft completion, prompt polishing, per-session suggestions and stale-response protection.",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lphehe-bot/dsh-composer-assist.git"
  },
  "homepage": "https://github.com/lphehe-bot/dsh-composer-assist",
  "bugs": {
    "url": "https://github.com/lphehe-bot/dsh-composer-assist/issues"
  }
}
