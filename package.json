{
  "name": "dsh-composer-assist",
  "version": "0.7.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "selfcheck": "node selfcheck.mjs && node scripts/bundle-freshness-selfcheck.mjs"
  },
  "dependencies": {
    "@zcode/dynamic-workflow": "file:vendor/zcode/dynamic-workflow",
    "@zcode/dynamic-workflow-runtime": "file:vendor/zcode/dynamic-workflow-runtime",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "vitest": "4.1.5",
    "esbuild": "^0.25.12"
  },
  "type": "module",
  "description": "Context-aware composer prediction and ZCode dynamic workflows for DeepSeek Harness: draft completion, prompt polishing, per-session suggestions and stale-response protection; typed actors, live graphs, durable runs and checkpoint recovery.",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
